generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  CHARGES
  PRODUITS
}

enum MoneyAccountType {
  BANK
  CASH
  OTHER
}

enum UserRole {
  ADMIN
  DEPARTMENT
}

enum DocumentType {
  INVOICE
}

enum DocumentOutputFormat {
  PDF
}

enum ExpensePaymentMethod {
  MY_MONEY
  FESTIVAL_ACCOUNT
}

enum ExpenseReportStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExpenseReportType {
  STANDARD
  DRIVING
}

enum TaskType {
  GENERAL
  REVIEW_EXPENSE_REPORT
  RECORD_JOURNAL
  STAFF_SHIFT
  DEPARTMENT_ACCESS_REQUEST
}

enum TaskStatus {
  PENDING
  DONE
}

model User {
  id                   String   @id @default(cuid())
  email                String   @unique
  passwordHash         String
  name                 String
  role                 UserRole @default(ADMIN)
  refundFirstName      String?
  refundLastName       String?
  refundIban           String?
  refundZip            String?
  refundCity           String?
  // Two-factor sign-in (TOTP). The seed is sealed with AES-256-GCM under the
  // same server-only master key as the Passwords vault (PASSWORD_VAULT_KEY) and
  // is only ever unsealed to check a code. `twoFactorEnabled` flips to true once
  // the user has proved they can produce a code from it — until then the three
  // columns hold a *pending* enrolment that login ignores.
  twoFactorEnabled     Boolean  @default(false)
  twoFactorCipher      String?
  twoFactorIv          String?
  twoFactorTag         String?
  // The edition this user is working in. Seeded once from the default edition
  // (see lib/edition-context.ts) and never touched again unless the user picks
  // another one — changing the default moves nobody.
  selectedEditionId    String?
  // The stock place this user is working in. Stock is edition-independent, so
  // this is remembered on its own: the app asks which place once and then opens
  // straight onto its contents.
  selectedStockPlaceId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // SetNull, not Cascade: deleting an edition must never delete the users who
  // happened to be looking at it. They re-seed on their next request.
  selectedEdition Edition? @relation("UserSelectedEdition", fields: [selectedEditionId], references: [id], onDelete: SetNull)

  // SetNull for the same reason: deleting a stock place must not delete the
  // users who happened to be looking at it — they land on the picker again.
  selectedStockPlace StockPlace? @relation("UserSelectedStockPlace", fields: [selectedStockPlaceId], references: [id], onDelete: SetNull)

  departments             Department[]
  journalEntries          JournalEntry[]
  submittedExpenseReports ExpenseReport[]         @relation("ExpenseReportSubmittedBy")
  reviewedExpenseReports  ExpenseReport[]         @relation("ExpenseReportReviewedBy")
  staffAssignments        StaffAssignment[]
  createdTasks            Task[]                  @relation("TaskCreator")
  assignedTasks           Task[]                  @relation("TaskAssignee")
  resolvedTasks           Task[]                  @relation("TaskResolver")
  createdAppointments     Appointment[]           @relation("AppointmentCreatedBy")
  appointmentInvites      AppointmentInviteUser[]
  createdTodos            Todo[]                  @relation("TodoCreator")
  assignedTodos           Todo[]                  @relation("TodoAssignee")
  createdPasswordEntries  PasswordEntry[]         @relation("PasswordEntryCreatedBy")
  stockMovements          StockMovement[]         @relation("StockMovementCreatedBy")

  @@index([selectedEditionId])
  @@index([selectedStockPlaceId])
}

// A department of the association — the team, not its money. Edition-independent
// on purpose: the same PROGRAMMATION carries from one edition to the next, and
// it is what a user belongs to, what a password is shared with and what an
// appointment invites. What it plans and spends is per-edition and lives in
// `DepartmentBudget`, one row per edition, created and removed by `hasBudget`.
model Department {
  id           String   @id @default(cuid())
  name         String   @unique
  // A short code for dense rows. Optional: the departments that predate this
  // screen have none until an admin fills them in.
  abbreviation String?
  // Whether this department budgets at all. Flipping it on opens a
  // `DepartmentBudget` in every edition; flipping it off closes them, and is
  // refused once any of them holds budget lines or journal entries.
  hasBudget    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  budgets            DepartmentBudget[]
  users              User[]
  passwordEntries    PasswordEntry[]
  // Pending DEPARTMENT_ACCESS_REQUEST tasks pointing at this department.
  tasks              Task[]
  journalEntries     JournalEntry[]
  expenseReports     ExpenseReport[]
  appointmentInvites AppointmentInviteDepartment[]
}

// Shared, department-scoped credential store. Secret fields (password, TOTP
// seed) are encrypted at rest with AES-256-GCM — see lib/secret-crypto.ts.
// Only the *Cipher/*Iv/*Tag columns ever hold secrets; everything else is
// plaintext so the DB can filter by department without decrypting.
model PasswordEntry {
  id             String  @id @default(cuid())
  name           String
  login          String
  website        String?
  // AES-256-GCM ciphertext components (base64). Password is required.
  passwordCipher String
  passwordIv     String
  passwordTag    String
  // Optional TOTP/2FA seed (base32 or otpauth:// URI), same encryption.
  totpCipher     String?
  totpIv         String?
  totpTag        String?

  createdById String?
  createdBy   User?   @relation("PasswordEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments Department[]

  @@index([name])
}

model Edition {
  id               String    @id @default(cuid())
  name             String    @unique
  startDate        DateTime?
  endDate          DateTime?
  drivingRatePerKm Decimal   @default(0.30) @db.Decimal(10, 2)
  // Seeds `User.selectedEditionId` for accounts that have none. It is not a
  // runtime fallback: flipping it moves nobody who is already using the app.
  isDefault        Boolean   @default(false)
  closedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  usersSelecting    User[]             @relation("UserSelectedEdition")
  departmentBudgets DepartmentBudget[]
  moneyAccounts     MoneyAccount[]
  costCenters       CostCenter[]
  invoices          Invoice[]
  expenseReports    ExpenseReport[]
  journalEntries    JournalEntry[]
  events            Event[]
  appointments      Appointment[]
  todos             Todo[]
  tasks             Task[]
}

// One department's budget inside one edition. It exists so a budget can be
// per-edition while the department is not — it carries no name and no settings
// of its own, only the lines. Journal entries do *not* hang off it: they carry
// their own `editionId` and point straight at the department, which is what
// lets a department be compared to its budget without going through this row.
model DepartmentBudget {
  id           String   @id @default(cuid())
  editionId    String
  departmentId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  edition     Edition      @relation(fields: [editionId], references: [id], onDelete: Cascade)
  department  Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  budgetLines BudgetLine[]

  @@unique([editionId, departmentId])
  @@index([departmentId])
}

model MoneyAccount {
  id                    String           @id @default(cuid())
  editionId             String
  name                  String
  type                  MoneyAccountType @default(BANK)
  openingBalance        Decimal          @default(0) @db.Decimal(14, 2)
  iban                  String?
  beneficiaryName       String?
  beneficiaryAddress    String?
  beneficiaryPostalCode String?
  beneficiaryCity       String?
  beneficiaryCountry    String           @default("CH")
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  edition        Edition        @relation(fields: [editionId], references: [id], onDelete: Cascade)
  invoices       Invoice[]
  journalEntries JournalEntry[]

  @@unique([editionId, name])
}

model CostCenter {
  id        String   @id @default(cuid())
  editionId String
  code      String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  edition        Edition        @relation(fields: [editionId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]
  events         Event[]

  @@unique([editionId, code])
}

model BudgetLine {
  id                 String      @id @default(cuid())
  departmentBudgetId String
  accountType        AccountType
  billingMonth       String?
  label              String
  unitPrice          Decimal?    @db.Decimal(10, 2)
  quantity           Decimal?    @db.Decimal(10, 2)
  amount             Decimal     @db.Decimal(10, 2)
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  departmentBudget DepartmentBudget @relation(fields: [departmentBudgetId], references: [id], onDelete: Cascade)
}

model JournalEntry {
  id              String      @id @default(cuid())
  editionId       String
  departmentId    String?
  moneyAccountId  String
  enteredById     String?
  costCenterId    String?
  accountType     AccountType
  sequenceNumber  Int
  date            DateTime
  amount          Decimal     @db.Decimal(10, 2)
  counterparty    String?
  label           String
  referenceNumber String?
  isOpeningEntry  Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  edition       Edition      @relation(fields: [editionId], references: [id], onDelete: Cascade)
  department    Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  moneyAccount  MoneyAccount @relation(fields: [moneyAccountId], references: [id], onDelete: Restrict)
  enteredBy     User?        @relation(fields: [enteredById], references: [id], onDelete: SetNull)
  costCenter    CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  linkedInvoice Invoice?     @relation("InvoiceJournalLink")

  @@unique([editionId, sequenceNumber])
  @@index([editionId, moneyAccountId])
  @@index([editionId, departmentId])
  @@index([editionId, costCenterId])
}

model DocumentTemplate {
  id           String               @id @default(cuid())
  documentType DocumentType
  outputFormat DocumentOutputFormat @default(PDF)
  name         String
  html         String
  isDefault    Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  invoices Invoice[]

  @@unique([documentType, name])
  @@index([documentType, isDefault])
}

model Invoice {
  id                   String    @id @default(cuid())
  editionId            String
  moneyAccountId       String
  templateId           String?
  linkedJournalEntryId String?   @unique
  invoiceNumber        String
  header               String?
  invoiceDate          DateTime
  dueDate              DateTime?
  supplierName         String
  supplierAddress      String
  supplierPostalCode   String
  supplierCity         String
  supplierCountry      String    @default("CH")
  creditorName         String
  creditorAddress      String
  creditorPostalCode   String
  creditorCity         String
  creditorCountry      String    @default("CH")
  bankAccountName      String
  iban                 String
  paymentReference     String?
  message              String?
  totalAmount          Decimal   @db.Decimal(14, 2)
  lineItems            Json
  qrPayload            String
  paidAt               DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  edition            Edition           @relation(fields: [editionId], references: [id], onDelete: Cascade)
  moneyAccount       MoneyAccount      @relation(fields: [moneyAccountId], references: [id], onDelete: Restrict)
  template           DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  linkedJournalEntry JournalEntry?     @relation("InvoiceJournalLink", fields: [linkedJournalEntryId], references: [id], onDelete: SetNull)

  @@unique([editionId, invoiceNumber])
  @@index([editionId, createdAt])
  @@index([linkedJournalEntryId])
}

model ExpenseReport {
  id              String               @id @default(cuid())
  editionId       String
  departmentId    String
  submittedById   String
  reviewedById    String?
  reportType      ExpenseReportType    @default(STANDARD)
  description     String
  departure       String?
  arrival         String?
  kilometers      Decimal?             @db.Decimal(10, 2)
  ratePerKm       Decimal?             @db.Decimal(10, 2)
  amount          Decimal              @db.Decimal(14, 2)
  paymentMethod   ExpensePaymentMethod
  date            DateTime
  proofData       Bytes?
  proofMimeType   String?
  proofFilename   String?
  status          ExpenseReportStatus  @default(PENDING)
  rejectionReason String?
  reviewedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  edition     Edition    @relation(fields: [editionId], references: [id], onDelete: Cascade)
  department  Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  submittedBy User       @relation("ExpenseReportSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy  User?      @relation("ExpenseReportReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  tasks       Task[]

  @@index([editionId, createdAt])
  @@index([status])
}

model Appointment {
  id          String    @id @default(cuid())
  editionId   String
  createdById String
  title       String
  description String
  startAt     DateTime
  endAt       DateTime?
  inviteAll   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  edition           Edition                       @relation(fields: [editionId], references: [id], onDelete: Cascade)
  createdBy         User                          @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  inviteUsers       AppointmentInviteUser[]
  inviteDepartments AppointmentInviteDepartment[]

  @@index([editionId, startAt])
}

model AppointmentInviteUser {
  id            String   @id @default(cuid())
  appointmentId String
  userId        String
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, userId])
  @@index([userId])
}

model AppointmentInviteDepartment {
  id            String   @id @default(cuid())
  appointmentId String
  departmentId  String
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  department  Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, departmentId])
  @@index([departmentId])
}

model EventType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events Event[]
}

model Event {
  id           String   @id @default(cuid())
  editionId    String
  eventTypeId  String
  costCenterId String?
  name         String
  startDate    DateTime
  endDate      DateTime
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  edition    Edition     @relation(fields: [editionId], references: [id], onDelete: Cascade)
  eventType  EventType   @relation(fields: [eventTypeId], references: [id], onDelete: Restrict)
  costCenter CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  days       EventDay[]

  @@index([editionId, startDate])
}

model EventDay {
  id        String   @id @default(cuid())
  eventId   String
  date      DateTime @db.Date
  isOff     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event  Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  shifts EventShift[]

  @@unique([eventId, date])
}

model EventShift {
  id         String   @id @default(cuid())
  eventDayId String
  startTime  String
  endTime    String
  role       String?
  capacity   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  eventDay    EventDay          @relation(fields: [eventDayId], references: [id], onDelete: Cascade)
  assignments StaffAssignment[]
}

model StaffAssignment {
  id        String   @id @default(cuid())
  shiftId   String
  userId    String
  createdAt DateTime @default(now())

  shift EventShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  task  Task?

  @@unique([shiftId, userId])
}

model Task {
  id                String     @id @default(cuid())
  type              TaskType
  status            TaskStatus @default(PENDING)
  title             String
  description       String?
  createdById       String?
  editionId         String?
  todoId            String?
  assignedToUserId  String?
  assignedToRole    UserRole?
  resolvedById      String?
  resolvedAt        DateTime?
  expenseReportId   String?
  staffAssignmentId String?    @unique
  // DEPARTMENT_ACCESS_REQUEST only: the department the creator asked to join.
  // The task is a *request*, never a grant — resolving it changes no membership.
  departmentId      String?
  dueDate           DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @default(now()) @updatedAt

  createdBy       User?            @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  edition         Edition?         @relation(fields: [editionId], references: [id], onDelete: Cascade)
  todo            Todo?            @relation(fields: [todoId], references: [id], onDelete: Cascade)
  assignedToUser  User?            @relation("TaskAssignee", fields: [assignedToUserId], references: [id], onDelete: Cascade)
  resolvedBy      User?            @relation("TaskResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  expenseReport   ExpenseReport?   @relation(fields: [expenseReportId], references: [id], onDelete: Cascade)
  staffAssignment StaffAssignment? @relation(fields: [staffAssignmentId], references: [id], onDelete: Cascade)
  department      Department?      @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([editionId])
  @@index([todoId])
  @@index([status, assignedToUserId])
  @@index([status, assignedToRole])
  @@index([status, departmentId])
}

model Todo {
  id               String   @id @default(cuid())
  editionId        String
  title            String
  description      String?
  createdById      String
  assignedToUserId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  edition        Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  createdBy      User    @relation("TodoCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignedToUser User?   @relation("TodoAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  tasks          Task[]

  @@index([editionId, createdById])
  @@index([editionId, assignedToUserId])
}

// ---------------------------------------------------------------------------
// Address book
// ---------------------------------------------------------------------------

/// A person or an organisation the festival deals with. Global, not edition-scoped:
/// a supplier does not stop existing when an edition closes, and every signed-in
/// user may read and write one (only an admin may delete).
/// What an address *is* to the festival — sponsor, supplier, partner, artist,
/// staff. Shown as "contact type" in the address book. A table rather than an
/// enum because admins add one from the book's settings without shipping a
/// migration; the five starting values are inserted by the migration that
/// creates this table. Blank stays a valid answer: not every contact has a role.
model AddressType {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses Address[]
}

model Address {
  id            String   @id @default(cuid())
  /// One of `firstName` / `companyName` is required — a row with neither has no
  /// name to be found by. Enforced in the server action, not by the database,
  /// because Postgres cannot express "either column" as a NOT NULL.
  firstName     String?
  lastName      String?
  companyName   String?
  street        String?
  country       String   @default("CH")
  postalCode    String?
  city          String?
  /// International dialling prefix, stored with its "+" ("+41"). Kept apart from
  /// the number so a list can be filtered by either.
  phonePrefix   String?
  phoneNumber   String?
  email         String?
  note          String?
  /// Optional on purpose — deleting a type leaves its addresses untyped rather
  /// than taking them with it.
  addressTypeId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  addressType  AddressType?         @relation(fields: [addressTypeId], references: [id], onDelete: SetNull)
  bankAccounts AddressBankAccount[]

  @@index([companyName])
  @@index([lastName])
  @@index([postalCode])
  @@index([addressTypeId])
}

/// One IBAN belonging to an address. An address can hold several — the same
/// supplier invoices from more than one account often enough.
model AddressBankAccount {
  id          String   @id @default(cuid())
  addressId   String
  displayName String
  street      String?
  postalCode  String
  city        String
  country     String   @default("CH")
  iban        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  address Address @relation(fields: [addressId], references: [id], onDelete: Cascade)

  @@index([addressId])
}

/// Postal code ↔ locality pairs, used to *propose* the other half of the pair
/// while typing. Never binding: an address keeps whatever was typed, so a
/// foreign or brand-new locality is still writable. Seeded with the Swiss list
/// (geonames.org, CC BY 4.0) and topped up from what users actually save.
model City {
  id         String   @id @default(cuid())
  country    String   @default("CH")
  postalCode String
  name       String
  createdAt  DateTime @default(now())

  @@unique([country, postalCode, name])
  @@index([country, postalCode])
  @@index([country, name])
}

// ---------------------------------------------------------------------------
// Stock
// ---------------------------------------------------------------------------

/// A place stock is held in — a container, a cellar, a van. Global, not
/// edition-scoped: what sits on a shelf does not stop existing when an edition
/// closes, and the next edition inherits it as it is.
model StockPlace {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items           StockItem[]
  movements       StockMovement[]
  selectedByUsers User[]          @relation("UserSelectedStockPlace")
}

/// The unit an item is measured in (l, ml, m, pce, m2, g, kg). A table rather
/// than an enum because admins add one without shipping a migration; the seven
/// starting values are inserted by the migration that creates this table.
model StockUnit {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  elements      StockElement[]
  convertsTo    StockUnitConversion[] @relation("StockUnitConversionFrom")
  convertedFrom StockUnitConversion[] @relation("StockUnitConversionTo")
}

/// "One `from` is `factor` `to`" — 1 ml is 0.001 l.
///
/// One row is one *direction*, because that is what the button offers: an item
/// filed as 1500 ml proposes "1.5 l", and the row that says so is ml → l. The
/// reverse is a second row, and admins are free to keep only the direction they
/// actually use.
///
/// This never converts anything on its own. It fills in a field a person is
/// looking at, before they save — stock already on a shelf is untouched by an
/// admin editing this table.
model StockUnitConversion {
  id         String   @id @default(cuid())
  fromUnitId String
  toUnitId   String
  /// How many `to` units one `from` unit is. Nine decimals so a factor like
  /// 0.001 survives, and so does one nobody has thought of yet.
  factor     Decimal  @db.Decimal(18, 9)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  fromUnit StockUnit @relation("StockUnitConversionFrom", fields: [fromUnitId], references: [id], onDelete: Cascade)
  toUnit   StockUnit @relation("StockUnitConversionTo", fields: [toUnitId], references: [id], onDelete: Cascade)

  @@unique([fromUnitId, toUnitId])
  @@index([fromUnitId])
}

/// What *can* be stocked — the catalogue entry, not the stock itself.
///
/// `unitQty` is the size of one piece: a 1.5 l bottle is unit = l, unitQty = 1.5.
/// A stock row then counts pieces and multiplies, so six of them read as
/// "6 x 1.5 l = 9 l" rather than as an ambiguous 6.
model StockElement {
  id         String   @id @default(cuid())
  name       String
  brand      String?
  /// The EAN/GTIN-13 printed on the packaging, when it has one. Unique because a
  /// scan has to land on exactly one catalogue entry — two entries sharing a code
  /// would make "is this already filed?" unanswerable.
  barcode    String?  @unique
  unitId     String
  unitQty    Decimal  @db.Decimal(12, 3)
  /// Whether a piece of this carries an expiry date. False hides the date
  /// everywhere — the field is not left empty, it is not drawn at all.
  expireable Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  unit      StockUnit       @relation(fields: [unitId], references: [id], onDelete: Restrict)
  items     StockItem[]
  movements StockMovement[]

  @@index([name])
  @@index([unitId])
}

/// One element, in one place, at one expiry date.
///
/// Two rows of the same element in the same place exist precisely when their
/// expiry dates differ — adding stock with a date that is already on the shelf
/// tops that row up instead of making a second one. The unique index says so for
/// dated rows; the undated ones are merged by the action, since Postgres counts
/// two NULLs as different values.
model StockItem {
  id           String    @id @default(cuid())
  stockPlaceId String
  elementId    String
  quantity     Int       @default(0)
  /// NULL when the element is not expireable, and when it is but the date is
  /// not known.
  expireDate   DateTime? @db.Date
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  stockPlace StockPlace      @relation(fields: [stockPlaceId], references: [id], onDelete: Cascade)
  element    StockElement    @relation(fields: [elementId], references: [id], onDelete: Restrict)
  movements  StockMovement[]

  @@unique([stockPlaceId, elementId, expireDate])
  @@index([stockPlaceId])
  @@index([elementId])
}

/// Every quantity change, in the order it happened: the +/- buttons, an edited
/// quantity, a new entry, a removal, and both legs of a move between places.
///
/// `delta` is a magnitude and `isIn` says which way it went, so a movement reads
/// the same whether or not the row it changed still exists — which is why
/// `stockItemId` is nullable and SetNull. Deleting the *place* does cascade:
/// the history of a place that is gone has nothing left to describe, and a
/// place can only be deleted once its items have been moved out.
model StockMovement {
  id           String    @id @default(cuid())
  stockPlaceId String
  elementId    String
  stockItemId  String?
  /// The dated shelf this movement was against, kept even after the row is gone.
  expireDate   DateTime? @db.Date
  delta        Int
  isIn         Boolean
  createdById  String?
  createdAt    DateTime  @default(now())

  stockPlace StockPlace   @relation(fields: [stockPlaceId], references: [id], onDelete: Cascade)
  element    StockElement @relation(fields: [elementId], references: [id], onDelete: Cascade)
  stockItem  StockItem?   @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  createdBy  User?        @relation("StockMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([stockPlaceId, createdAt])
  @@index([elementId])
  @@index([createdAt])
}
