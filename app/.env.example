# Postgres container, started with `docker compose up -d db` from this directory.
# Only ever read on an empty volume: changing these later does not change the
# credentials an existing database already has.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="baleinev_comptes"
POSTGRES_PORT="5434"

# PostgreSQL connection, for the app and for Prisma. Must agree with the POSTGRES_*
# values above; percent-encode the password if it contains URL-unsafe characters.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/baleinev_comptes?schema=public"

# Session signing key. Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# Public URL of the app. Required by NextAuth outside development.
NEXTAUTH_URL="http://localhost:3000"

# First admin account, created or updated by `npm run db:seed`.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Baleinev Admin"

# Local development only. When "1" (and NODE_ENV is not production),
# `npm run db:seed` also creates dev-department@baleinev.local (role DEPARTMENT,
# password "devpassword") and a closed edition, so the docs/plans verification
# steps that need a non-admin or a closed edition are runnable. Leave unset on
# the server — the seed there must never grow a second login.
SEED_DEV_FIXTURES=""

# Master key for the Passwords vault. Encrypts stored passwords and 2FA seeds
# with AES-256-GCM. Must be 32 bytes, base64-encoded. Generate with:
#   openssl rand -base64 32
# Rotating this key makes every stored secret unreadable — see docs/passwords.md.
PASSWORD_VAULT_KEY=""
